# ─── UFV Invest — variáveis de ambiente (web) ─────────────────────────────────────────
# Copie para .env.local (dev) ou cadastre na Vercel → Project → Settings → Environment Variables.
# Nenhuma API de dados exige chave: NASA POWER, PVGIS, Open-Meteo, IBGE, BCB e Binance são abertas.

# Rede: 97 = BNB Smart Chain Testnet (padrão, demonstração) | 56 = BNB Smart Chain mainnet
NEXT_PUBLIC_CHAIN_ID=97

# URL pública do site (domínio do login SIWE, QR code do PDF, metadados)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# RPCs próprios (opcional — há fallback para RPCs públicos). Ex.: NodeReal, Ankr, QuickNode
NEXT_PUBLIC_BSC_RPC_URL=
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=

# WalletConnect / Reown (opcional — habilita carteiras móveis e Ledger Live via QR)
# Crie em https://dashboard.reown.com e restrinja o projectId ao seu domínio.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Segredo das sessões SIWE (≥ 32 caracteres aleatórios; obrigatório em produção).
# Gere com: openssl rand -hex 32   — cadastre como "Sensitive" na Vercel.
SESSION_SECRET=

# KYC: encaminha os pedidos ao seu back-office/provedor (opcional)
KYC_WEBHOOK_URL=
KYC_WEBHOOK_TOKEN=
