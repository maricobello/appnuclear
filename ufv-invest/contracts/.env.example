# ─── UFV Invest — contratos ─────────────────────────────────────────────────────────────────
# Copie para .env e preencha. NUNCA versione o .env (está no .gitignore).

# Chave privada da carteira que faz o deploy (paga o gás). Use uma carteira NOVA e dedicada,
# com só o BNB necessário. Ela fica como admin temporária até a Safe aceitar a transferência.
DEPLOYER_PRIVATE_KEY=

# RPCs (use um provedor dedicado em produção; os públicos têm limite de taxa)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Admin final de todos os contratos — recomendado: Safe multisig (ex.: 3 de 5).
# Se vazio, o próprio deployer fica como admin (aceitável apenas em testnet).
ADMIN_ADDRESS=
# Carteira que deposita a receita mensal da SPE (DISTRIBUTOR_ROLE). Padrão: ADMIN_ADDRESS.
DISTRIBUTOR_ADDRESS=
# Operador de KYC (COMPLIANCE_ROLE no IdentityRegistry e nos tokens). Padrão: ADMIN_ADDRESS.
# Costuma ser uma carteira de backend (hot wallet) com permissão só de KYC/documentos.
COMPLIANCE_ADDRESS=
# Tesouraria da SPE que recebe os recursos captados no finalize(). OBRIGATÓRIO na mainnet.
TREASURY_ADDRESS=

# Token de pagamento. Testnet/hardhat: vazio = faz deploy do MockUSDT.
# Mainnet: vazio = USDT BEP-20 oficial 0x55d398326f99059fF775485246999027B3197955.
PAYMENT_TOKEN_ADDRESS=

# Opcional: só estas usinas (slugs separados por vírgula). Vazio = todas de config/plants.json.
PLANTS=
# Opcional: ignora endereços já gravados em deployments/<chainId>.json e faz tudo de novo.
FORCE_REDEPLOY=false
# Opcional: em chainId 31337 o deploy NÃO grava no web/src/data/deployments.json, a menos que
# esta flag seja true (evita versionar endereços locais por engano).
WRITE_WEB_DEPLOYMENTS=false
# Opcional: caminho alternativo do deployments.json do front.
WEB_DEPLOYMENTS_FILE=

# Verificação no BscScan (API v2 multichain do Etherscan: uma chave serve para BSC e BSC testnet)
ETHERSCAN_API_KEY=

# Relatório de gás nos testes (npm run test:gas)
REPORT_GAS=false
