{
  "name": "ufv-invest-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Contratos inteligentes da UFV Invest (BNB Smart Chain): registro de identidade (KYC), token de cotas por usina com distribuição de receita e oferta primária com escrow.",
  "license": "UNLICENSED",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "clean": "hardhat clean",
    "export:abi": "hardhat compile && ts-node scripts/export-abi.ts",
    "deploy:local": "hardhat run scripts/deploy.ts --network hardhat",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network bsc",
    "verify": "hardhat run scripts/verify.ts",
    "admin:kyc": "hardhat run scripts/admin/kyc.ts",
    "admin:distribute": "hardhat run scripts/admin/distribute.ts",
    "admin:document": "hardhat run scripts/admin/set-document.ts",
    "admin:finalize": "hardhat run scripts/admin/finalize-settle.ts",
    "admin:accept": "hardhat run scripts/admin/accept-admin.ts",
    "admin:status": "hardhat run scripts/admin/status.ts",
    "admin:mock-mint": "hardhat run scripts/admin/mock-mint.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "hardhat-gas-reporter": "^2.3.0",
    "solc": "0.8.28",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  }
}
