# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# credenciais de conta de serviço do Firebase nunca vão para o git
*service-account*.json
*-firebase-adminsdk-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dados baixados para a avaliação em dados reais (npm run eval:real)
/data

# coletor do PLD: chave e CSV baixado ficam só no computador de quem roda
scripts/chave.txt
scripts/pld*.csv
chave.txt
pld*.csv

# radar da comunidade: gerado localmente a partir do export do WhatsApp; não publicar (repo público)
docs/radar/*.md
*.zip
_chat.txt
