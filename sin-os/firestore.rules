rules_version = '2';

// Todo acesso ao Firestore passa pelas rotas de API da Vercel (Firebase Admin SDK,
// que ignora estas regras). Clientes web/mobile não leem nem escrevem diretamente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
