# ─── SIN OS — variáveis de ambiente ──────────────────────────────────────────
# Copie para .env.local (dev) ou cadastre em Vercel → Project → Settings → Environment Variables.
# Nenhuma é obrigatória: sem elas o app roda com dados públicos + persistência em memória.

# Política de dados: auto (padrão: real → fallback → simulação sinalizada) | live (só real) | demo (tudo simulado)
DATA_MODE=auto

# ── Firebase (Firestore) — persistência de auditorias, relatórios e histórico de PLD
# Opção 1 (recomendada na Vercel): JSON da conta de serviço inteiro, em texto ou base64
FIREBASE_SERVICE_ACCOUNT=
# Opção 2: campos separados (a chave privada com \n escapados)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Agente auditor: usa a GROQ_API_KEY (abaixo, a mesma da Iara); sem ela só a auditoria
#    determinística roda. Só é acionado com CRON_SECRET ou ADMIN_KEY.

# ── Coletor do PLD oficial (scripts/coletor-ccee.mjs, roda no seu computador)
# Chave longa e aleatória, a mesma no coletor e na Vercel (Sensitive)
PLD_INGEST_KEY=

# ── Iara (assistente de voz) — chaves só na Vercel, como Sensitive; nunca no código.
# Groq: chat (Kimi K2 → gpt-oss-120b → …) e transcrição Whisper
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   # primeiro da lista da Groq (o Kimi K2 0905 saiu da Groq em 15/04/2026)
# GROQ_STT_MODEL=whisper-large-v3-turbo
# Outros provedores (troca automática no 429 ou se a chave falhar):
# GEMINI_API_KEY=                    # Google AI Studio (grátis; no plano grátis os dados podem treinar o Google)
# DEEPSEEK_API_KEY=                  # pago, muito barato
# OPENROUTER_API_KEY=                # modelos :free (50 pedidos/dia sem crédito)
# MOONSHOT_API_KEY=                  # Kimi direto na Moonshot
# IARA_PROVIDERS=groq,gemini         # ordem da cadeia (padrão: todos com chave)
# IARA_MODELS_GROQ=…                 # modelos por provedor, separados por vírgula
# IARA_DAILY_TOKENS=600000           # teto diário de tokens (todas as pessoas)
# IARA_REQUEST_TOKENS=24000          # teto de tokens de prompt por pergunta
# Senha: a simples do front (src/lib/assistant/access.ts) vale enquanto ASSISTANT_SIMPLE_CODE≠off
ASSISTANT_ACCESS_CODE=
# ASSISTANT_SIMPLE_CODE=off          # desliga a senha simples (só o código acima)
# NEXT_PUBLIC_IARA_SENHA=            # troca a senha simples sem mexer no código (exige novo deploy)
# ASSISTANT_DAILY_LIMIT=400          # perguntas/dia (todas as pessoas)
# ASSISTANT_STT_DAILY_LIMIT=250      # transcrições/dia
# ASSISTANT_TTS_DAILY_LIMIT=900      # blocos de voz natural/dia
# GD_DAILY_LIMIT=3000                # faturas lidas/dia
# Voz natural (escolha um; sem nenhum, a Iara usa a melhor voz neural do navegador):
#   GEMINI_API_KEY sozinha já liga o Gemini TTS (voz "Kore"; TTS_VOICE troca; TTS_PROVIDER=off desliga)
#   OpenAI: TTS_BASE_URL=https://api.openai.com/v1 + TTS_API_KEY + TTS_MODEL=gpt-4o-mini-tts + TTS_VOICE=nova
#   servidor OpenVoice/Kokoro (voz-server/), ElevenLabs (eleven_multilingual_v2) ou Azure (Thalita Multilingual)
# TTS_BASE_URL=https://SEU-USUARIO-SEU-SPACE.hf.space
# TTS_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=brazilsouth

# ── Segurança das rotas de auditoria
# A Vercel envia "Authorization: Bearer $CRON_SECRET" automaticamente nos crons.
CRON_SECRET=
# Chave para acionar a auditoria + agente manualmente pela interface
ADMIN_KEY=

# ── APIs opcionais
# Chave gratuita: https://www.eia.gov/opendata/register.php (Henry Hub e Brent)
EIA_API_KEY=

# PLD OFICIAL em D+1 — CCEE Plataforma de Integração (só para agentes da CCEE ou consultorias
# com representação total). Web service SOAP listarPLD com autenticação SSL mútua.
# CCEE_PI_CERT_PFX = conteúdo do certificado ICP-Brasil (.pfx/.p12) em base64:
#   base64 -w0 certificado.pfx   (macOS: base64 -i certificado.pfx)
# Cadastre estas variáveis como "Sensitive" na Vercel — nunca no repositório.
CCEE_PI_USERNAME=
CCEE_PI_PASSWORD=
CCEE_PI_PERFIL=
CCEE_PI_CERT_PFX=
CCEE_PI_CERT_PASSPHRASE=
# CCEE_PI_HOST=https://servicos.ccee.org.br:443
# CCEE_PI_PAGE_SIZE=240

# ── Limites do PLD (padrão 2026, ANEEL Despacho 3.850/2025). Atualize a cada ano.
# PLD_MIN=57.31
# PLD_MAX_ESTRUTURAL=785.27
# PLD_MAX_HORARIO=1611.04

# Alertas: webhook (Slack/Discord/ntfy/Teams) avisado quando a auditoria degrada.
# Opcional; sem ele, a saúde ainda aparece em /api/health (200 saudável / 503 degradado).
ALERT_WEBHOOK_URL=
# Score mínimo abaixo do qual a saúde é considerada degradada (padrão 70).
ALERT_MIN_SCORE=70
